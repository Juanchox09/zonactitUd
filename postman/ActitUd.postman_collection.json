{
  "info": {
    "name": "ActitUd · Validación de carnet UTP",
    "description": "Pruebas de la API ActitUd (FastAPI, puerto 4000) y del mock de la API de Estado de Estudiante UTP (puerto 8090).\nLevantar antes: docker compose up --build",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "utp",
      "value": "http://localhost:8090/api/v1"
    },
    {
      "key": "utp_token",
      "value": ""
    },
    {
      "key": "comercio_id",
      "value": "1"
    },
    {
      "key": "descuento_id",
      "value": "1"
    },
    {
      "key": "admin_usuario",
      "value": "admin"
    },
    {
      "key": "admin_contrasena",
      "value": "actitud2026"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "tienda_id",
      "value": ""
    },
    {
      "key": "oferta_id",
      "value": ""
    },
    {
      "key": "tienda_usuario_id",
      "value": ""
    },
    {
      "key": "comercio_token",
      "value": ""
    },
    {
      "key": "tienda_usuario",
      "value": "tienda.postman"
    },
    {
      "key": "cajero_usuario",
      "value": ""
    },
    {
      "key": "cajero_id",
      "value": ""
    },
    {
      "key": "cajero_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "API ActitUd",
      "item": [
        {
          "name": "Preparación · login admin",
          "request": {
            "method": "POST",
            "url": "{{api}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"usuario\": \"admin\", \"contrasena\": \"actitud2026\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"admin_token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Preparación · tienda con oferta vigente hoy",
          "request": {
            "method": "GET",
            "url": "{{api}}/comercios",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"hay al menos una tienda con oferta hoy\", () => pm.expect(pm.response.json().length).to.be.above(0));",
                  "pm.collectionVariables.set(\"comercio_id\", pm.response.json()[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar sin sesión (401)",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=8-123-456",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401: validar exige iniciar sesión\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Salud",
          "request": {
            "method": "GET",
            "url": "{{api}}/salud"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y base de datos ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().baseDatos).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cédula · estudiante activo",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=8-123-456&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ACTIVO', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().estado).to.eql('ACTIVO');",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cédula con ceros a la izquierda",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=08-0123-00456&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('se normaliza a 8-123-456', () => pm.expect(pm.response.json().cedula).to.eql('8-123-456'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cédula · estudiante inactivo",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=8-234-567&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('INACTIVO (200, no error)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().estado).to.eql('INACTIVO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "QR del carné · extranjero activo",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?qr=RS04LTEyMzQ1QHV0cC5hYy5wYQ%3D%3D&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('E-8-12345', () => pm.expect(pm.response.json().cedula).to.eql('E-8-12345'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Foto del QR (OpenCV)",
          "request": {
            "method": "POST",
            "url": "{{api}}/carnets/validar-imagen",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imagen",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "comercio_id",
                  "value": "{{comercio_id}}",
                  "type": "text"
                }
              ]
            },
            "description": "Elegir en 'imagen' un PNG de frontend/demo-qr/ (utp-*.png).",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          }
        },
        {
          "name": "No encontrado (404)",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=8-999-999&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sistema de matrícula caído (503)",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=8-500-500&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('503 con Retry-After, nunca inactivo', () => {",
                  "  pm.response.to.have.status(503);",
                  "  pm.expect(pm.response.headers.get('Retry-After')).to.eql('30');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Timeout de 5 s (503)",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=8-600-600&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('503 en unos 5 s', () => {",
                  "  pm.response.to.have.status(503);",
                  "  pm.expect(pm.response.responseTime).to.be.below(6000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cédula con formato inválido (400)",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?cedula=abc&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "QR inválido (400)",
          "request": {
            "method": "GET",
            "url": "{{api}}/carnets/validar?qr=zzz&comercio_id={{comercio_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ],
      "description": "\nValidar exige sesión: cada validación registra la tienda y el descuento aplicado. Aquí se valida como admin indicando la tienda (comercio_id); el personal de tienda no la indica, se toma de su sesión."
    },
    {
      "name": "Mock API UTP (directo)",
      "item": [
        {
          "name": "1 · Obtener token",
          "request": {
            "method": "POST",
            "url": "{{utp}}/auth/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "carnet-qr-tesis"
                },
                {
                  "key": "client_secret",
                  "value": "mock-secret"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token emitido', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('utp_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 · Estado por cédula",
          "request": {
            "method": "GET",
            "url": "{{utp}}/estudiantes/8-123-456/estado",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{utp_token}}"
              }
            ]
          }
        },
        {
          "name": "3 · Validar carné (QR)",
          "request": {
            "method": "POST",
            "url": "{{utp}}/estudiantes/validar-carne",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{utp_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"token_qr\": \"OC0xMjMtNDU2QHV0cC5hYy5wYQ==\" }"
            }
          }
        },
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "url": "{{utp}}/estudiantes/8-123-456/estado"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token sin permiso (403)",
          "request": {
            "method": "GET",
            "url": "{{utp}}/estudiantes/8-123-456/estado",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer mock-token-sin-permiso"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reportería (propuesta)",
      "item": [
        {
          "name": "Comercios y descuentos",
          "request": {
            "method": "GET",
            "url": "{{api}}/comercios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "if (c.length) { pm.collectionVariables.set(\"comercio_id\", c[0].id); pm.collectionVariables.set(\"descuento_id\", c[0].descuentos[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar en una tienda · guarda su descuento",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/carnets/validar?cedula=8-123-456&comercio_id={{comercio_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "carnets",
                "validar"
              ],
              "query": [
                {
                  "key": "cedula",
                  "value": "8-123-456"
                },
                {
                  "key": "comercio_id",
                  "value": "{{comercio_id}}"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 activo con el descuento de la tienda\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json().descuento;",
                  "  pm.expect(d).to.be.an(\"object\");",
                  "  pm.expect(d.porcentaje).to.be.a(\"number\");",
                  "  pm.expect(d.canjeId).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar inactivo en una tienda · sin descuento",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{api}}/carnets/validar?cedula=8-234-567&comercio_id={{comercio_id}}",
              "host": [
                "{{api}}"
              ],
              "path": [
                "carnets",
                "validar"
              ],
              "query": [
                {
                  "key": "cedula",
                  "value": "8-234-567"
                },
                {
                  "key": "comercio_id",
                  "value": "{{comercio_id}}"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"INACTIVO y sin descuento\", () => {",
                  "  const t = pm.response.json();",
                  "  pm.expect(t.estado).to.eql(\"INACTIVO\");",
                  "  pm.expect(t).to.not.have.property(\"descuento\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar canje · estudiante activo",
          "request": {
            "method": "POST",
            "url": "{{api}}/canjes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"comercio_id\": {{comercio_id}}, \"descuento_id\": {{descuento_id}}, \"cedula\": \"8-123-456\", \"monto_compra\": 12.50 }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 200 si el mismo estudiante ya se registró en esta tienda hace menos de 10 minutos",
                  "pm.test(\"201 o 200 (ya registrado)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar canje · estudiante inactivo (409)",
          "request": {
            "method": "POST",
            "url": "{{api}}/canjes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"comercio_id\": {{comercio_id}}, \"descuento_id\": {{descuento_id}}, \"cedula\": \"8-234-567\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reporte sin sesión (401)",
          "request": {
            "method": "GET",
            "url": "{{api}}/reportes?dias=30"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin · contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "url": "{{api}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"usuario\": \"{{admin_usuario}}\", \"contrasena\": \"incorrecta\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401 sin token\", () => { pm.response.to.have.status(401); pm.expect(pm.response.json()).to.not.have.property(\"token\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "url": "{{api}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"usuario\": \"{{admin_usuario}}\", \"contrasena\": \"{{admin_contrasena}}\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 con token\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"admin_token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reporte de 30 días",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{api}}/reportes?dias=30",
              "host": [
                "{{api}}"
              ],
              "path": [
                "reportes"
              ],
              "query": [
                {
                  "key": "dias",
                  "value": "30"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 con resumen\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property(\"resumen\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Panel del comercio y validación (OE5 y OE6)",
      "description": "Ejecutar en orden después de «Login admin». Crea una tienda con nombre único, su usuario, publica una oferta, valida en ella y lee métricas y el reporte de validación.",
      "item": [
        {
          "name": "Admin · listar comercios",
          "request": {
            "method": "GET",
            "url": "{{api}}/admin/comercios",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 lista\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin · afiliar tienda",
          "request": {
            "method": "POST",
            "url": "{{api}}/admin/comercios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tienda Postman {{$timestamp}}\",\n  \"categoria\": \"Shopping\",\n  \"activo\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 creada\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"tienda_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin · crear usuario de la tienda",
          "request": {
            "method": "POST",
            "url": "{{api}}/admin/comercios/{{tienda_id}}/usuarios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
