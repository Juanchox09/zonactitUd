# Puerto e interfaz donde escucha la API.
PORT=4000
HOST=0.0.0.0

# Archivo SQLite. Se crea automáticamente si no existe.
DB_PATH=data/carnets.db

# Orígenes permitidos por CORS (separados por coma). Con el proxy de Vite no hace falta en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Máximo de consultas por minuto por IP (evita la enumeración masiva de cédulas).
RATE_LIMIT_MAX=30

# Zona horaria con la que se determina si un carnet ya venció.
ZONA_HORARIA=America/Panama

# De dónde sale el estado:
#   local → solo la base SQLite (datos de prueba o importados con npm run db:seed)
#   utp   → estudiantes desde la API de Estado de Estudiante UTP; colaboradores y egresados desde SQLite
ORIGEN=local

# API UTP (solo con ORIGEN=utp). Las credenciales nunca van en el frontend.
UTP_API_URL=http://localhost:8090/api/v1
UTP_CLIENT_ID=
UTP_CLIENT_SECRET=
# Timeout por solicitud (el contrato recomienda 5 s).
UTP_TIMEOUT_MS=5000
# La API admite 60 solicitudes/min por cliente; este límite propio deja margen.
UTP_LIMITE_POR_MINUTO=55
# Segundos que se reutiliza una respuesta para no repetir la misma consulta (0 = sin caché).
UTP_CACHE_SEGUNDOS=30
