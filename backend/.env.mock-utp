# Conecta el backend al mock de la API UTP (npm run mock:utp). Lo usa "npm run dev:utp".
# Son las credenciales de prueba públicas del contrato, no secretos reales.
ORIGEN=utp
UTP_API_URL=http://localhost:8090/api/v1
UTP_CLIENT_ID=carnet-qr-tesis
UTP_CLIENT_SECRET=mock-secret
# Sin caché: los estudiantes que agregues en mock-utp/estudiantes.json se ven al instante.
UTP_CACHE_SEGUNDOS=0
