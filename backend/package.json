{
  "name": "validacion-carnet-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/sembrar.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "mock:utp": "node mock-utp/servidor.ts",
    "dev:utp": "node --watch --env-file-if-exists=.env --env-file=.env.mock-utp src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
